# ==============================================================================
# Orbital Year Tracker - Environment Configuration Template
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (Client-Safe / Publishable Key)
# NOTE: This key is designed to be public and works in tandem with PostgreSQL Row-Level Security (RLS).
# NEVER put your Supabase service_role key here!
VITE_SUPABASE_ANON_KEY=your-anon-key-here
